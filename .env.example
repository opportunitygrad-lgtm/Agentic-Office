# ─────────────────────────────────────────────────────────────────────────────
# AI Business OS — environment template
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit `.env`. See docs/SECURITY.md for secret-handling rules.
# Values below are LOCAL DEVELOPMENT defaults only (docker compose services).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Core infrastructure ─────────────────────────────────────────────────────
DATABASE_URL=postgres://aibos:aibos_dev_password@localhost:5432/aibos
# Tests create/migrate this database automatically; never point it at real data.
TEST_DATABASE_URL=postgres://aibos:aibos_dev_password@localhost:5432/aibos_test
REDIS_URL=redis://localhost:6379

# ── Services ────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated origins allowed to call the API directly (the web app proxies /api).
API_CORS_ORIGINS=http://localhost:3000
# Used by the Next.js server to reach the API.
API_URL=http://localhost:4000
# Public origin of the web app: allowed Origin for state-changing requests and
# base URL for invitation / password-reset links.
WEB_ORIGIN=http://localhost:3000
# Proxies trusted for X-Forwarded-For (the web app's /api rewrite runs locally).
TRUST_PROXY=127.0.0.1,::1
# Session cookies are Secure automatically when NODE_ENV=production.
# COOKIE_SECURE=true
WORKER_CONCURRENCY=2

# ── AI providers ────────────────────────────────────────────────────────────
# Claude — DEFAULT transport: the owner's local Claude Code, signed in with the
# Claude Pro subscription. Authenticate ONCE in Terminal (never in this app):
#   unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN; claude logout; claude login
# The worker must run on the same machine/user account where you ran `claude login`.
CLAUDE_TRANSPORT=claude_code
CLAUDE_CODE_BINARY=claude
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_EFFORT=medium
# Premium is used only when company policy allows it and your plan includes it.
CLAUDE_CODE_PREMIUM_MODEL=opus
CLAUDE_CODE_PREMIUM_EFFORT=high
# Subscription capacity is finite: Claude Code runs at a time (others queue).
CLAUDE_CODE_MAX_CONCURRENCY=1
# Operational limits for subscription runs (instead of per-call dollars).
CLAUDE_CODE_MAX_RUNS_PER_TASK_DAY=10
CLAUDE_CODE_MAX_RUNS_PER_AGENT_DAY=40
CLAUDE_CODE_MAX_INPUT_TOKENS=60000
# Only set to true if you deliberately route Claude Code through a custom
# ANTHROPIC_BASE_URL; otherwise it is stripped from the Claude Code process.
CLAUDE_CODE_ALLOW_BASE_URL=false

# OPTIONAL future transport — Anthropic API-key billing. Disabled unless
# CLAUDE_TRANSPORT=anthropic_api. Not needed for normal operation; never
# passed to Claude Code (API credentials would override the subscription).
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_WORKSPACE_ID=
# CLAUDE_DEFAULT_MODEL=claude-sonnet-5
# CLAUDE_PREMIUM_MODEL=claude-opus-5-5
# CLAUDE_DEFAULT_EFFORT=medium
# CLAUDE_PREMIUM_EFFORT=high

# Provider request timeout (ms) and chat history window (messages).
AI_PROVIDER_TIMEOUT_MS=180000
CHAT_HISTORY_MAX_MESSAGES=12
# "mock" uses the deterministic mock Claude (no usage; refused in production).
AIBOS_AI_PROVIDER_MODE=live
# Live smoke tests (`pnpm test:claude-subscription-live`, `pnpm test:claude-live`)
# refuse unless this is exactly "true".
ALLOW_LIVE_AI_TESTS=false
# OpenAI / Grok are NOT connected until later stages.
OPENAI_API_KEY=
XAI_API_KEY=

# ── Microsoft Graph / Outlook (Stage 14) ────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ── Google (Sheets, Drive, GA4, Search Console — Stages 12, 25, 26) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Meta (Stages 19–23) ─────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=

# ── WordPress (Stage 27) — per-company application passwords ────────────────
# WORDPRESS_<COMPANY_SLUG>_URL=
# WORDPRESS_<COMPANY_SLUG>_APP_PASSWORD=

# ── CRM / webhooks (Stages 13, 36) ──────────────────────────────────────────
CRM_API_KEY=
WEBHOOK_SIGNING_SECRET=

# ── Auth & encryption (Stage 02 / Stage 12) ─────────────────────────────────
# First Platform Owner for `pnpm auth:bootstrap` (password is prompted, never stored here).
BOOTSTRAP_ADMIN_EMAIL=
# 32-byte key for the encrypted credential vault (introduced in Stage 12).
CREDENTIALS_ENCRYPTION_KEY=
