{
  "name": "@aibos/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./testing": "./test/helpers.ts",
    "./dev-seed": "./src/seed/dev/seed-dev.ts",
    "./auth": "./src/auth/crypto.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed/run.ts",
    "db:reset": "tsx src/reset.ts && tsx src/migrate.ts && tsx src/seed/run.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "auth:bootstrap": "tsx src/auth/bootstrap.ts",
    "claude:live": "tsx src/live/claude-smoke.ts",
    "claude:subscription-live": "tsx src/live/claude-subscription-smoke.ts"
  },
  "dependencies": {
    "@aibos/access-core": "workspace:*",
    "@aibos/agent-core": "workspace:*",
    "@aibos/context-core": "workspace:*",
    "@aibos/delegation-core": "workspace:*",
    "@aibos/execution-core": "workspace:*",
    "@aibos/integration-core": "workspace:*",
    "@aibos/provider-core": "workspace:*",
    "@aibos/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
